        "jsCode": "const context = $('Memoria — Normalizar contexto persistente1').first().json;\nlet raw = $input.first().json.output ?? $input.first().json.text ?? $input.first().json;\nlet parsed = raw;\nif (typeof raw === 'string') {\n  try { parsed = JSON.parse(raw); }\n  catch (e) {\n    parsed = {\n      resumen_consolidado: 'Caso procesado por integraciones externas. Requiere revisión del resumen.',\n      estado_del_caso: $('Set — Payload mínimo integraciones1').first().json.requires_human ? 'requiere_revision' : 'en_proceso',\n      datos_clave: { motivo: 'salida_no_json', canal: 'gmail' },\n      cantidad_intercambios: Number(context.memory?.exchange_count || 0) + 1\n    };\n  }\n}\nreturn [{ json: {\n  record_id: context.memory?.record_id || null,\n  memory_exists: Boolean(context.memory?.exists),\n  session_id: $('Set — Payload limpio soporte1').first().json.session_id,\n  request_id: $('Set — Payload limpio soporte1').first().json.request_id,\n  resumen_consolidado: parsed.resumen_consolidado || 'Caso procesado por el agente.',\n  estado_del_caso: parsed.estado_del_caso || 'en_proceso',\n  datos_clave: JSON.stringify(parsed.datos_clave || {}),\n  cantidad_intercambios: Number(parsed.cantidad_intercambios || (Number(context.memory?.exchange_count || 0) + 1)),\n  ultima_intencion: $('Set — Payload mínimo integraciones1').first().json.intent,\n  ultimo_worker: $('Set — Payload mínimo integraciones1').first().json.selected_worker,\n  requiere_humano: Boolean($('Set — Payload mínimo integraciones1').first().json.requires_human)\n}}];"
