    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const clean = $('Set — Payload limpio soporte').first().json;\nconst records = $input.all().map(i => i.json).filter(r => r && r.id);\nconst first = records[0] || null;\nconst fields = first?.fields || {};\nlet keyData = {};\ntry { keyData = fields['Datos Clave'] ? JSON.parse(fields['Datos Clave']) : {}; }\ncatch (e) { keyData = { raw: fields['Datos Clave'] }; }\nreturn [{ json: {\n  ...clean,\n  memory: {\n    exists: !!first,\n    record_id: first?.id || null,\n    last_summary: fields['Resumen Consolidado'] || '',\n    case_status: fields['Estado del Caso'] || 'nuevo',\n    key_data: keyData,\n    exchange_count: Number(fields['Cantidad Intercambios'] || 0)\n  }\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        0
      ],
      "id": "7ea46a38-f0cd-46e6-bf60-5f857d156633",
      "name": "Memoria — Normalizar contexto persistente"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Mensaje del usuario:\n{{$json.user_message}}\n\n[INICIO DE CONTEXTO COMPARTIDO]\nSession_ID: {{$json.session_id}}\nEstado previo: {{$json.memory.case_status}}\nResumen previo: {{$json.memory.last_summary || 'No existe resumen previo.'}}\nDatos clave: {{JSON.stringify($json.memory.key_data || {})}}\n[FIN DEL CONTEXTO COMPARTIDO]",
        "options": {
          "systemMessage": "# ROL\n\nSos el Manager de un sistema multi-agente de soporte para ticketing cultural ficticio.\n\n# OBJETIVO\n\nClasificás el mensaje entrante y generás una respuesta breve para borrador humano en Gmail.\n\n# TAXONOMÍA\n\nSolo podés clasificar en: VENTA, POSTVENTA o RECLAMO.\n\n# REGLAS\n\nNo inventes políticas, precios, fechas ni acciones administrativas. No confirmes reembolsos, reenvíos ni cambios de ticket. Si falta información, solicitá datos mínimos. Si hay reclamo, devolución, ticket no recibido, QR inválido, cancelación o suspensión, marcá requires_human=true.\n\n# FORMATO DE SALIDA\n\nDevolvé exclusivamente JSON válido:\n\n{\"intent\":\"VENTA | POSTVENTA | RECLAMO\",\"selected_worker\":\"worker_venta_cultural | worker_postventa_reclamos\",\"requires_human\":true,\"priority\":\"low | medium | high\",\"draft_response\":\"texto para borrador Gmail\",\"routing_reason\":\"motivo breve\"}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -440,
        0
      ],
      "id": "9455dd48-92cf-4069-a879-72c497c23c38",
      "name": "AI Agent — Manager integraciones"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -500,
        220
      ],
      "id": "0b389a38-9f12-4600-83f2-5fe561418c33",
      "name": "OpenAI Chat Model — Manager"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const context = $('Memoria — Normalizar contexto persistente').first().json;\nlet raw = $input.first().json.output ?? $input.first().json.text ?? $input.first().json;\nlet parsed = raw;\nif (typeof raw === 'string') {\n  try { parsed = JSON.parse(raw); }\n  catch (e) { parsed = { intent:'RECLAMO', selected_worker:'worker_postventa_reclamos', requires_human:true, priority:'medium', draft_response:raw, routing_reason:'Salida no JSON; revisión humana.' }; }\n}\nreturn [{ json: {\n  ...context,\n  intent: parsed.intent || 'RECLAMO',\n  selected_worker: parsed.selected_worker || 'worker_postventa_reclamos',\n  requires_human: Boolean(parsed.requires_human),\n  priority: parsed.priority || 'medium',\n  response: parsed.draft_response || parsed.response || 'El caso requiere revisión del equipo.',\n  routing_reason: parsed.routing_reason || ''\n}}];"
      },
