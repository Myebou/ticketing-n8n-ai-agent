      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst message = String(body.message || body.text || body.input || '').trim();\nconst orderId = body.order?.order_id || body.order_id || null;\n\nreturn [{ json: {\n  request_id: body.request_id || `MOD2-${Date.now()}`,\n  session_id: body.session_id || body.phone || body.email || 'session-demo-mod2',\n  channel: body.channel || 'postman',\n  user_message: message,\n  event_context: {\n    event_name: body.event?.event_name || body.event_name || null,\n    event_date: body.event?.event_date || body.event_date || null,\n    order_id_masked: orderId ? `ORD-***${String(orderId).slice(-3)}` : null\n  },\n  control: {\n    source_workflow: 'manager_modulo2_paredes_alexis',\n    data_minimization: true,\n    raw_payload_forwarded_to_worker: false\n  }\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        0
      ],
      "id": "475c8a57-2f48-48b7-bc0b-f01dc45db4e8",
      "name": "Determinístico — Normalizar entrada mínima"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.user_message }}",
        "options": {
          "systemMessage": "# ROL\nSos un orquestador de atención para ticketing cultural. Tu única tarea es clasificar la intención del mensaje y decidir el área de negocio.\n\n# TAXONOMÍA CERRADA\nRespondé únicamente una de estas palabras: VENTA, POSTVENTA o RECLAMO.\n\n# VENTA\nUsá VENTA cuando la persona pregunta antes de comprar: precios, lista de eventos, cartelera, fechas, horarios, formas de pago, disponibilidad, cómo comprar o ubicación de la sala.\n\n# POSTVENTA\nUsá POSTVENTA cuando la persona ya compró y necesita información o seguimiento sin expresar disconformidad grave: dónde ver su entrada, cómo consultar su QR, cómo funciona una política, cómo pedir factura o cómo solicitar revisión.\n\n# RECLAMO\nUsá RECLAMO cuando la persona manifiesta un problema, incumplimiento o disconformidad: pagó y no recibió entrada, QR inválido, cobro incorrecto, devolución exigida, evento cancelado/suspendido, acceso denegado o queja formal.\n\n# REGLAS\nNo resuelvas la consulta. No expliques. No uses JSON. No agregues puntuación. No uses lenguaje inclusivo. Si hay duda entre POSTVENTA y RECLAMO, priorizá RECLAMO cuando exista problema o riesgo económico.",
          "maxIterations": 5,
          "returnIntermediateSteps": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
